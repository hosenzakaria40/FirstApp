                                                                           8. overlayColor

                                                                           কাজ:
                                                                           Button Press, Hover অথবা Focus করলে যে Effect দেখা যায় তার Color পরিবর্তন করে।

                                                                           Syntax:

                                                                           NavigationBar(
                                                                           overlayColor: MaterialStateProperty.all(
                                                                           Colors.red,
                                                                           ),
                                                                           )

                                                                           Advanced:

                                                                           overlayColor: MaterialStateProperty.resolveWith((states) {

                                                                           if (states.contains(MaterialState.pressed)) {
                                                                           return Colors.red;
                                                                           }

                                                                           if (states.contains(MaterialState.hovered)) {
                                                                           return Colors.blue;
                                                                           }

                                                                           return null;

                                                                           })

